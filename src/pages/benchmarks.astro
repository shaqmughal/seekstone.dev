---
/**
 * /benchmarks — the full benchmark page (SHA-116). The trust signal no
 * competitor has: open-source harness, reproducible methodology, honest
 * trade-offs. Every figure here mirrors the landing page (SHA-106 Benchmark +
 * FAQ) — no new numbers are introduced; the <Benchmark/> section is reused
 * verbatim so the latency chart can never drift between the two pages. Every
 * figure is read from src/data/benchmarks.json (SHA-327).
 */
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Benchmark from "../components/Benchmark.astro";
import Card from "../components/Card.astro";
import CodeBlock from "../components/CodeBlock.astro";
import Icon from "../components/Icon.astro";
import Metric from "../components/Metric.astro";
import {
	type AdapterKey,
	adapter,
	BIG,
	COMPETITOR_COUNT,
	COMPETITORS,
	fmtKB0,
	fmtKB1,
	fmtMB1,
	fmtMillions,
	fmtMin,
	fmtMs,
	fmtMs1,
	fmtMsUnit,
	fmtSec,
	fmtSec1,
	GATE_V2,
	HEADLINE,
	latencyRange,
	multiplier,
	numberWord,
	query10k,
	QUERY_SET,
	REST,
	RETRIEVAL_DATE,
	RETRIEVAL_DEFAULT,
	RETRIEVAL_LEXICAL,
	RETRIEVAL_MCP_PRO,
	RETRIEVAL_QUALITY,
	RETRIEVAL_TC,
	RETRIEVAL_TC_GRAPH,
	scaleRows,
	SCALING,
	SEEKSTONE,
	SEMANTIC_MS,
	SIZE_LABELS,
} from "../data/benchmarks";

const contextTax = multiplier(HEADLINE.contextTax.display); // "47,000×"
const payloadKB = fmtKB0(HEADLINE.payloadBytes10k); // "2"
const worst = HEADLINE.worstQuery;
const seekQueryMs = SEEKSTONE.queries10k.map((q) => q.warmMedianMs);
// Seekstone's own figure for the field's worst broad query — like-for-like with the
// mcp-obsidian / REST numbers beside it, not the four-query mean.
const seekBroad = query10k("seekstone", worst.query);
// The plugin's HTTP API measured directly, vs Seekstone — floored to thousands like the headline.
const restTax = Math.floor(REST.payloadBytes[BIG] / SEEKSTONE.payloadBytes[BIG] / 1000) * 1000;
const fastest = HEADLINE.fastestCompetitor;
const restOfField = latencyRange(COMPETITORS.map(([k]) => k).filter((k) => k !== fastest.adapter));

// Architecture tiers are explicit key lists (never the free-text `architecture`
// label) and must partition the benchmarked field — a re-sync that adds or
// renames a competitor fails the build here instead of rendering a half-empty tier.
const SCANNERS: AdapterKey[] = ["mcpvault", "obsidian-mcp-pro", "obsidian-mcp", "obsidian-mcp-rs"];
const PLATFORMS: AdapterKey[] = ["obsidian-tc"];
const PROXIES: AdapterKey[] = ["obsidian-mcp-server", "mcp-obsidian"];
const tiered = [...SCANNERS, ...PLATFORMS, ...PROXIES];
const fieldKeys = COMPETITORS.map(([k]) => k);
const untiered = fieldKeys.filter((k) => !tiered.includes(k));
const stale = tiered.filter((k) => !fieldKeys.includes(k));
if (untiered.length > 0 || stale.length > 0 || new Set(tiered).size !== fieldKeys.length) {
	throw new Error(
		`benchmarks.astro: tiers do not partition the benchmarked field (unassigned: ${untiered.join(", ") || "none"}; not in benchmarks.json: ${stale.join(", ") || "none"})`,
	);
}
const fastestScanner = SCANNERS.map((k) => [k, adapter(k)] as const).reduce((a, b) => (b[1].warmMs[BIG] < a[1].warmMs[BIG] ? b : a));
const otherScanners = latencyRange(SCANNERS.filter((k) => k !== fastestScanner[0]));
const round10 = (v: number) => Math.round(v / 10) * 10;
const tc = adapter("obsidian-tc");

const title = "Benchmarks: Seekstone vs Obsidian REST API | Seekstone";
const description =
	`Full payload and latency benchmark comparing Seekstone (filesystem-direct MCP) against the Obsidian Local REST API plugin and ${numberWord(COMPETITOR_COUNT)} other servers, across 1k / 5k / 10k-note vaults. Up to ~${contextTax} smaller search payloads, fully reproducible with an open-source harness.`;

// Seekstone vs the Obsidian Local REST API plugin measured DIRECTLY over HTTP
// (the `rest` harness backend) on the committed 10,000-note vault — the
// lower-bound baseline. REST-proxy MCP servers that wrap the plugin return
// more (mcp-obsidian's broad query is the headline figure in the <Benchmark/>
// fit card and the repo README). All from benchmarks.json → scaling.adapters.rest.
const COMPARE: [metric: string, seekstone: string, rest: string][] = [
	["Search payload (mean, 10k vault)", `~${payloadKB} KB`, fmtMB1(REST.payloadBytes[BIG])],
	["Worst-case payload (broad query)", `~${fmtKB0(seekBroad.payloadBytes)} KB`, fmtMB1(REST.worst10k?.bytes ?? 0)],
	["Context tokens (broad query)", `~${Math.round(seekBroad.payloadTokens / 10) * 10}`, fmtMillions(REST.worst10k?.tokens ?? 0)],
	[
		"Warm keyword search (10k vault)",
		`${fmtMsUnit(SEEKSTONE.warmMs[BIG])} mean (${fmtMs1(Math.min(...seekQueryMs))}–${fmtMs1(Math.max(...seekQueryMs))} across queries)`,
		`~${fmtMsUnit(REST.warmMs[BIG])} mean`,
	],
	["Obsidian app required", "No", "Yes"],
	["Local REST API plugin required", "No", "Yes"],
	["Network calls", "Zero", "HTTP to localhost"],
	["Search matching", "Fuzzy + prefix · optional local semantic", "Exact / plugin-dependent"],
	["Frontmatter write safety", "Byte-identical", "Varies"],
];

// How each server scales as the vault grows (1k → 5k → 10k notes) — the heart
// of the story. Seekstone stays flat on both payload and latency; the proxies
// climb. Rows come from benchmarks.json, ascending by the 10k value.
const SIZES = SIZE_LABELS;
const SCALE_PAYLOAD = scaleRows("payloadBytes");
const SCALE_LATENCY = scaleRows("warmMs");

// The semantic head-to-head (retrieval-eval-competitors) — same golden set,
// same vault, same run. Seekstone rows first, then the field.
const semRow = (
	label: string,
	c: typeof RETRIEVAL_DEFAULT | typeof RETRIEVAL_TC,
	needs: string,
	you: boolean,
	note = "",
) => ({
	label,
	note,
	you,
	hit: `${c.overallHit5.toFixed(1)}%`,
	holdout: `${c.holdoutHit5.toFixed(1)}%`,
	p50: c.warmP50Ms >= 1000 ? `${fmtSec1(c.warmP50Ms)} (p95 ${fmtSec1(c.warmP95Ms)})` : fmtMsUnit(c.warmP50Ms),
	payload: you ? `~${payloadKB} KB` : fmtKB1(c.payloadBytes),
	index: "indexBuildMs" in c ? fmtSec(c.indexBuildMs) : "indexMs" in c ? fmtMin(c.indexMs) : "—",
	needs,
});
const OFFLINE = "Nothing — in-process, offline";
const OLLAMA = "Ollama server + native modules + Node ≥ 24";
const SEMANTIC_ROWS = [
	semRow("Seekstone quality mode", RETRIEVAL_QUALITY, OFFLINE, true, "(opt-in 32M + MaxSim)"),
	semRow("Seekstone default (8M + MaxSim)", RETRIEVAL_DEFAULT, OFFLINE, true),
	semRow("obsidian-tc semantic", RETRIEVAL_TC, OLLAMA, false),
	{ ...semRow("obsidian-tc GraphRAG", RETRIEVAL_TC_GRAPH, "(same)", false), index: "(same)" },
];
const bestHoldout = Math.max(...SEMANTIC_ROWS.map((r) => Number.parseFloat(r.holdout)));
const bestHit = Math.max(...SEMANTIC_ROWS.map((r) => Number.parseFloat(r.hit)));
const graphLatencyVsDefault = Math.round(RETRIEVAL_TC_GRAPH.warmP50Ms / RETRIEVAL_DEFAULT.warmP50Ms / 10) * 10;
const graphLatencyVsQuality = Math.round(RETRIEVAL_TC_GRAPH.warmP50Ms / RETRIEVAL_QUALITY.warmP50Ms / 10) * 10;
const graphPayloadRatio = Math.round(RETRIEVAL_TC_GRAPH.payloadBytes / HEADLINE.payloadBytes10k);

// The read-out below is prose with a direction baked into its wording: tc's plain
// mode edges our best shipped mode on holdout, tc GraphRAG is the most accurate,
// and the pre-registered gate was missed. Numbers interpolate; wording cannot.
// Fail the build the moment the data stops supporting the sentence.
const readoutHolds =
	RETRIEVAL_TC.holdoutHit5 > RETRIEVAL_QUALITY.holdoutHit5 &&
	RETRIEVAL_TC_GRAPH.holdoutHit5 > RETRIEVAL_TC.holdoutHit5 &&
	RETRIEVAL_TC_GRAPH.holdoutHit5 === bestHoldout &&
	GATE_V2.verdict === "fail" &&
	worst.adapter === "mcp-obsidian";
if (!readoutHolds) {
	throw new Error(
		"benchmarks.astro: the semantic read-out's wording (tc plain edges our quality mode on holdout; tc GraphRAG most accurate; gate v2 missed; mcp-obsidian is the worst broad query) no longer matches benchmarks.json — rewrite the paragraph, then remove/adjust this assertion",
	);
}

// Three architectures, three scaling behaviours. The frame that makes the
// tables legible — and puts Seekstone alone in the top tier.
const TIERS: { tier: string; who: string; body: string }[] = [
	{
		tier: "In-process index",
		who: "Seekstone",
		body: "Holds a warm full-text index and returns ranked excerpts. Flat on both payload and latency — a few KB and a few ms at any vault size.",
	},
	{
		tier: "Subprocess scanners",
		who: SCANNERS.join(" · "),
		body: `Spawn a process and scan the disk per query. Latency climbs with the vault — the fastest (${fastestScanner[0]}${fastestScanner[0] === "obsidian-mcp-rs" ? ", Rust" : ""}) is still ~${fastestScanner[1].vsSeekstone10k?.display}× slower than Seekstone at 10,000 notes; the rest run ~${fmtMs(round10(otherScanners.min))}–${fmtMs(round10(otherScanners.max))} ms at 10k notes.`,
	},
	{
		tier: "Database platforms",
		who: PLATFORMS.join(" · "),
		body: `SQLite index behind a governance pipeline. Search runs ~${fmtSec1(tc.warmMs[BIG])} warm at 10,000 notes, and its read envelope returns each note's content twice.`,
	},
	{
		tier: "REST proxies",
		who: `Local REST API · ${PROXIES.join(" · ")}`,
		body: "Forward to Obsidian's HTTP API, which returns full note content for every hit — tens of megabytes per search, growing with the vault.",
	},
];

const REPRO = `git clone https://github.com/shaqmughal/seekstone
cd seekstone && npm install
npm run harness -- bench --backend fs \\
  --vault packages/harness/fixtures/vault`;

// Honest accounting — qualitative only; no unverified figures invented.
const TRADEOFFS: [icon: string, title: string, body: string][] = [
	[
		"database",
		"It keeps an index in memory.",
		"Seekstone builds a small in-process search index (a few MB for a typical vault). If you run many MCP servers at once, that's real RAM the REST plugin offloads to the already-running Obsidian process.",
	],
	[
		"zap",
		"The first query is the slow one.",
		`Cold start pays for the index build before the millisecond latencies above: a few seconds on a typical vault, tens of seconds on our 10,000-note benchmark vault. Enabling semantic search adds a background embedding pass on top (~${fmtSec(RETRIEVAL_DEFAULT.indexBuildMs)} at 10k — cached per-vault, so restarts reload it instantly).`,
	],
	[
		"search",
		"Semantic search is opt-in, not default.",
		"Keyword search (fuzzy + prefix) is the default. Since 0.15.0, semantic and hybrid modes search by meaning through a small local embedding model: run npx -y seekstone fetch-model once (~30 MB, checksum-verified) and set SEEKSTONE_SEMANTIC=1. The costs, plainly: the one-time download, a background embedding pass at startup, and a per-vault vector cache under ~/.cache/seekstone. After that nothing ever leaves your machine — and if you never opt in, none of it exists.",
	],
];
---

<Base title={title} description={description}>
	<Nav />
	<main>
		<section class="section section--tight">
			<div class="container container--narrow">
				<div class="head head--center">
					<span class="eyebrow eyebrow--center"><Icon name="gauge" size={13} /> Reproducible benchmark</span>
					<h1 class="bm__h1">Benchmarked against<br />the whole field.</h1>
					<p>
						Every number on this page comes from an open-source harness run on committed
						vaults of 1,000, 5,000, and 10,000 notes — public-domain content, {SCALING.runs} runs per
						query. Nothing here is a marketing estimate — the vaults ship in the repo, so
						clone it and reproduce each figure exactly.
					</p>
				</div>
			</div>
		</section>

		{/* Reused verbatim from the landing page: headline stats + latency chart.
		    Single-sourcing guarantees the two pages never disagree. */}
		<Benchmark />

		<section class="section" id="payload">
			<div class="container container--narrow">
				<div class="head">
					<span class="eyebrow"><Icon name="gauge" size={13} /> Where it's actually won</span>
					<h2>Latency is nice. Payload is the point.</h2>
					<p>
						REST-proxy servers return full note content for every search hit — tens of
						megabytes the model has to read. Seekstone returns short ranked excerpts.
						Same query, up to ~{contextTax} less to send at 10,000 notes (the plugin's HTTP
						API alone is ~{multiplier(restTax)}; proxy envelopes push it higher).
					</p>
				</div>
				<Card padding="lg" class="bm__tablecard">
					<div class="bm__tablewrap">
						<table class="bm__table">
							<thead>
								<tr>
									<th>Metric</th>
									<th class="bm__col-you">Seekstone</th>
									<th>REST API plugin</th>
								</tr>
							</thead>
							<tbody>
								{
									COMPARE.map(([metric, seek, rest]) => (
										<tr>
											<td class="bm__metric">{metric}</td>
											<td class="bm__col-you">{seek}</td>
											<td class="bm__rest">{rest}</td>
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</Card>
				<p class="bm__note">
					This table measures the Local REST API plugin's HTTP API directly — the lower
					bound for any server built on it. MCP servers that proxy the plugin add
					JSON-RPC encoding on top: the same broad query via {worst.adapter} averaged
					{fmtMB1(worst.bytes).replace(" ", "\u00a0")} / {fmtMillions(worst.tokens).replace(" ", "\u00a0")} tokens per call.
				</p>
				<p class="bm__note">
					The rest of the field spans ~{fmtMs(round10(restOfField.min))}–{fmtMs(restOfField.max)} ms warm search latency at 10,000 notes
					in the chart above (one exception: {fastest.adapter} at {fmtMs(fastest.warmMs)} ms); Seekstone's
					in-process index serves the same queries in single-digit milliseconds — and
					the gap only widens as the vault grows.
				</p>
			</div>
		</section>

		<section class="section section--tight" id="scaling">
			<div class="container container--narrow">
				<div class="head">
					<span class="eyebrow"><Icon name="gauge" size={13} /> The whole point</span>
					<h2>Watch what happens as your vault grows.</h2>
					<p>
						A real vault only gets bigger — and that's where the architectures diverge.
						Seekstone holds a warm in-process index, so it stays flat on <em>both</em> payload
						and latency, while REST-proxy and full-scan servers climb with every note.
					</p>
				</div>

				<div class="bm__tiers">
					{
						TIERS.map((t) => (
							<Card padding="lg" class="bm__tier">
								<span class="bm__tier-tier">{t.tier}</span>
								<span class="bm__tier-who">{t.who}</span>
								<p class="bm__tier-body">{t.body}</p>
							</Card>
						))
					}
				</div>

				<h3 class="bm__scale-h">Search payload — bytes per query <span class="bm__lower">lower is better</span></h3>
				<Card padding="lg" class="bm__tablecard">
					<div class="bm__tablewrap">
						<table class="bm__table bm__table--scale">
							<thead>
								<tr><th>Server</th>{SIZES.map((s) => <th>{s} notes</th>)}</tr>
							</thead>
							<tbody>
								{
									SCALE_PAYLOAD.map((r) => (
										<tr class={r.you ? "is-you" : ""}>
											<td class={r.you ? "bm__col-you" : "bm__metric"}>{r.name}</td>
											{r.vals.map((v) => <td class={r.you ? "bm__col-you" : "bm__rest"}>{v}</td>)}
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</Card>

				<h3 class="bm__scale-h bm__scale-h--gap">Warm search latency — milliseconds <span class="bm__lower">lower is better</span></h3>
				<Card padding="lg" class="bm__tablecard">
					<div class="bm__tablewrap">
						<table class="bm__table bm__table--scale">
							<thead>
								<tr><th>Server</th>{SIZES.map((s) => <th>{s} notes</th>)}</tr>
							</thead>
							<tbody>
								{
									SCALE_LATENCY.map((r) => (
										<tr class={r.you ? "is-you" : ""}>
											<td class={r.you ? "bm__col-you" : "bm__metric"}>{r.name}</td>
											{r.vals.map((v) => <td class={r.you ? "bm__col-you" : "bm__rest"}>{v}</td>)}
										</tr>
									))
								}
							</tbody>
						</table>
					</div>
				</Card>

				<p class="bm__note">
					At 10,000 notes that's a <strong>~{contextTax} payload difference</strong>, and Seekstone is
					<strong>{HEADLINE.restProxyRange.display.min}–{HEADLINE.restProxyRange.display.max}× faster</strong> than the REST proxies — both gaps widening with scale.
					Seekstone is the only server that stays flat on <em>both</em> axes.
				</p>
			</div>
		</section>

		<section class="section section--tight" id="methodology">
			<div class="container container--narrow">
				<div class="head">
					<span class="eyebrow"><Icon name="terminal" size={13} /> Methodology</span>
					<h2>Run it yourself.</h2>
					<p>
						The harness lives in the Seekstone repo. It runs each query set against every
						adapter and reports cold (run 1) and warm (runs 2–N) distributions separately —
						a cheap warm number can't hide a brutal cold start.
					</p>
				</div>
				<ul class="bm__method">
					<li><span class="bm__k">Vaults</span><span>Committed 1,000 / 5,000 / 10,000-note vaults generated from the public-domain 1911 Encyclopædia Britannica — the same size distribution as a real PKM vault, and byte-for-byte reproducible.</span></li>
					<li><span class="bm__k">Runs</span><span>{SCALING.runs} per query; warm latency reported as the mean of per-query medians (run 1 excluded as cold).</span></li>
					<li><span class="bm__k">Payload</span><span>Bytes measured on the actual MCP tool response, not an idealized excerpt.</span></li>
					<li><span class="bm__k">Field</span><span>Compared against {COMPETITORS.map(([, a]) => a.label).slice(0, -1).join(", ")}, and {COMPETITORS.at(-1)?.[1].label}.</span></li>
				</ul>
				<div class="bm__repro">
					<CodeBlock chrome title="Terminal" code={REPRO} />
				</div>
			</div>
		</section>

		<section class="section section--tight" id="semantic">
			<div class="container container--narrow">
				<div class="head head--center">
					<span class="eyebrow eyebrow--center"><Icon name="search" size={13} /> Re-benchmarked {RETRIEVAL_DATE}</span>
					<h2>Semantic search, measured the same way.</h2>
					<p>
						Opt-in meaning-based search through a small local embedding model — fully in-process,
						offline at runtime, no API key, no native modules — with a MaxSim rerank on top since
						0.17.0. Evaluated on the same committed 10,000-note vault with a {QUERY_SET.total}-query golden set
						and a locked-away held-out split.
					</p>
				</div>
				<div class="bench__stats">
					<Card variant="glow" padding="lg"><Metric value={`${Math.round(RETRIEVAL_DEFAULT.semanticSubsetHit5)}%`} label="hit@5 on description-style queries" sub={`vs ${Math.round(RETRIEVAL_LEXICAL.semanticSubsetHit5)}% for keyword search alone (default model)`} accent="gradient" size="lg" /></Card>
					<Card padding="lg"><Metric value={`~${SEMANTIC_MS}`} unit="ms" label="warm semantic search at 10k notes" sub={`default model; the opt-in quality model measures ${Math.round(RETRIEVAL_QUALITY.warmP50Ms)} ms`} accent="green" size="lg" /></Card>
					<Card padding="lg"><Metric value={`${Math.round(RETRIEVAL_DEFAULT.lexicalSubsetHit5)}%`} label="exact-title lookups kept" sub="hybrid mode routes them to keyword search" accent="violet" size="lg" /></Card>
				</div>
				<p class="bm__note">
					Numbers from the committed <a href="https://github.com/shaqmughal/seekstone/blob/main/packages/harness/fixtures/baseline-reports/retrieval-eval-competitors.md" target="_blank" rel="noreferrer">retrieval-quality baseline</a> —
					a single synthetic vault and our own golden query set.
					Reproducible: <code>npm run harness -- retrieval --shipped</code>.
				</p>

				<div class="head head--center" style="margin-top: 3rem;">
					<h3>And benchmarked against the field — losses included.</h3>
					<p>
						Same golden set, same vault, same run, competitor semantic search measured
						head-to-head. We pre-registered a gate to claim the top spot, missed it,
						and published the miss with the same prominence a win would have gotten —
						and the fixture-v2 re-baseline shown here moved the numbers in both directions.
					</p>
				</div>
				<Card padding="lg" class="bm__tablecard">
					<div class="bm__tablewrap">
						<table class="bm__table">
							<thead>
								<tr><th>Semantic search</th><th>hit@5 ({QUERY_SET.total}q)</th><th>held-out</th><th>Latency (p50)</th><th>Payload/query</th><th>Cold index</th><th>Needs</th></tr>
							</thead>
							<tbody>
								{
									SEMANTIC_ROWS.map((r) => {
										const B = (v: string, strong: boolean) => (strong ? <strong>{v}</strong> : v);
										return (
											<tr>
												<td>{r.note ? <><strong>{r.label}</strong> {r.note}</> : r.label}</td>
												<td>{B(r.hit, Number.parseFloat(r.hit) === bestHit)}</td>
												<td>{B(r.holdout, Number.parseFloat(r.holdout) === bestHoldout)}</td>
												<td>{B(r.p50, r.you)}</td>
												<td>{B(r.payload, r.you)}</td>
												<td>{B(r.index, r.you)}</td>
												<td>{B(r.needs, r.you)}</td>
											</tr>
										);
									})
								}
								<tr><td>{RETRIEVAL_MCP_PRO.label}</td><td colspan="5">Failed — could not index the 10k-note vault (crashed after ~{fmtMin(RETRIEVAL_MCP_PRO.indexMs)} of embedding)</td><td>Ollama or OpenAI</td></tr>
							</tbody>
						</table>
					</div>
				</Card>
				<p class="bm__note">
					The honest read, both directions: obsidian-tc's plain semantic mode <strong>edges
					Seekstone's best shipped mode on the held-out split</strong> ({RETRIEVAL_TC.holdoutHit5.toFixed(1)}% vs
					{RETRIEVAL_QUALITY.holdoutHit5.toFixed(1)}%) — at {Math.round(RETRIEVAL_TC.warmP50Ms)} ms per query against our
					{Math.round(RETRIEVAL_QUALITY.warmP50Ms)} ms, a {fmtMin(RETRIEVAL_TC.indexMs)}ute Ollama index against our {fmtSec(RETRIEVAL_QUALITY.indexBuildMs)}, and a
					second server you install, run, and keep a 137M-parameter model loaded in. Its GraphRAG
					mode is <strong>the most accurate we benchmarked</strong> ({RETRIEVAL_TC_GRAPH.holdoutHit5.toFixed(1)}% held-out),
					at seconds per query ({fmtSec1(RETRIEVAL_TC_GRAPH.warmP50Ms)} median, {fmtSec1(RETRIEVAL_TC_GRAPH.warmP95Ms)} p95 —
					{graphLatencyVsQuality}–{graphLatencyVsDefault}× ours) and ~{graphPayloadRatio}× the payload. Seekstone is the only
					benchmarked server whose semantic search needs nothing but Seekstone. We pre-registered a
					gate to call ourselves #1 on fixture v1 and missed it; no new gate ran on the fixture-v2
					re-baseline shown here, and the same clauses recompute to the same miss. Verdict and
					read-out, clause by clause, are committed:
